#!/bin/bash
#PBS -N b1_train
#PBS -P li96
#PBS -q dgxa100
#PBS -l storage=gdata/li96+scratch/li96
#PBS -l ncpus=16
#PBS -l mem=120GB
#PBS -l ngpus=1
#PBS -l walltime=03:00:00
#PBS -l wd
#PBS -j oe
#PBS -o /scratch/li96/mz9869/logs/

# B1 FULL training — 5-head linked, offline general cache (unchanged from
# Phase A), v1 hyperparams. Single new variable vs Phase A = head count 3->5.
#   - heads 0-2 warm-start from Phase A best; heads 3-4 fresh (base lm_head +
#     identity body)
#   - loss weights geometric extension [1.0, 0.8, 0.64, 0.512, 0.41]
#   - DETACH env (default false) records the smoke verdict; keep in lockstep
#     with what b1_smoke.pbs concluded
#   - ckpt -> linked_medusa_5head_b1/ (does NOT touch v1 / Phase A)
# A100 because 5-head fp32 params+grads+8bit optim ~= 35GB > V100 32GB.

set -euo pipefail
echo "=== JOB $(hostname) $(date) job=${PBS_JOBID:-unset} ==="
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader | head -1

module load python3/3.11.0 cuda/12.3.2
source ~/medusa-env/bin/activate
cd ~/medusa-qwen

DETACH=${DETACH:-false}
echo "=== detach_chain = $DETACH (from smoke verdict) ==="

python -u -m scripts.train --config config/linked_medusa_default.yaml --override \
    dataset.kind=cached \
    dataset.cache_dir=/scratch/li96/mz9869/cached_data/llava_general_35k \
    dataset.eval_split=last_1000 \
    model.num_heads=5 \
    model.detach_chain=$DETACH \
    model.warm_start_from=/scratch/li96/mz9869/medusa_outputs/linked_medusa_phaseA_general/ckpt_best.pt \
    training.total_steps=8500 \
    "training.loss_weights=[1.0,0.8,0.64,0.512,0.41]" \
    logging.log_every=50 \
    logging.eval_every=500 \
    logging.save_every=1000 \
    logging.output_dir=/scratch/li96/mz9869/medusa_outputs/linked_medusa_5head_b1

echo "=== DONE $(date) ==="
