#!/bin/bash
# 队列② 全量:longform 特征抽取 37,079 条 → 145 片 safetensors。
# 用户裁定放行(2026-08-21):pilot 判据 2 越界归因成立(行集构成),
# 体积判据改分层口径,双数字入档——分层预测 1,119 GB / DOCCI 顶格上界
# 1,335 GB;收官报实测对两数落点(归因模型免费检验)。
# 预算:~3.2 GPU·h ≈ 230 SU 预期,walltime 07:00(上限 504 SU 计费封顶);
# 代码 commit 01c738e(R1 合并写 + R2 mismatch_head16,pilot 已验)。
#PBS -P li96
#PBS -q dgxa100
#PBS -l ncpus=16
#PBS -l ngpus=1
#PBS -l mem=100GB
#PBS -l jobfs=10GB
#PBS -l walltime=07:00:00
#PBS -l storage=gdata/li96+scratch/li96
#PBS -l wd
#PBS -N d15_ext_full
#PBS -o /scratch/li96/mz9869/logs/
#PBS -j oe
#PBS -m ae
#PBS -M 920928763@qq.com

set -u
module load python3/3.11.0 cuda/12.3.2
source ~/medusa-env/bin/activate
export HF_HOME=/scratch/li96/mz9869/tmp_hf_download/
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export PIP_CACHE_DIR=/scratch/li96/mz9869/tmp_pip_cache/

OUT=/scratch/li96/mz9869/dflash_data/longform_ctx_cache
cd /home/562/mz9869/medusa-qwen
echo "=== d15_ext_full $(date) commit $(git rev-parse --short HEAD) ==="
echo "--- lquota before ---"; lquota 2>/dev/null | grep -E "li96 +scratch" || true

python -u scripts/extract_ctx_longform.py --out-dir ${OUT}
RC=$?

echo "--- lquota after ---"; lquota 2>/dev/null | grep -E "li96 +scratch" || true

python - <<PYEOF
import json, sys
from pathlib import Path
import torch
from safetensors.torch import load_file
OUT = Path("${OUT}")
m = json.load(open(OUT / "ctx_manifest.json"))
agg = m.get("aggregate_runs", [m["aggregate"]])[-1] if "aggregate" not in m else m["aggregate"]
shard_bytes = sum((OUT / f).stat().st_size for f in m["shards"].values())
gb = shard_bytes / 1e9
n_ok = sum(1 for v in m["samples"].values() if not v.get("failed"))
fmt_ok, fmt_err = True, []
try:
    t = load_file(OUT / m["shards"]["0"])
    for i in ("0", "1", "2"):
        ctx, ids, spans = t[f"{i}.ctx"], t[f"{i}.ids"], t[f"{i}.spans"]
        ok = (ctx.dtype == torch.bfloat16 and ctx.shape[0] == 5
              and ctx.shape[2] == 3584 and ids.dtype == torch.int64
              and spans.dtype == torch.int64 and spans.shape == (6,)
              and int(spans[5]) == ctx.shape[1] == ids.shape[0])
        if not ok:
            fmt_ok = False; fmt_err.append(i)
except Exception as e:
    fmt_ok, fmt_err = False, [str(e)[:120]]
s = {"job": "${PBS_JOBID}", "kind": "d15_extract_full", "exit": ${RC},
     "n_done": agg["n_done"], "n_failed": agg["n_failed"],
     "n_samples_ok": n_ok, "n_shards": len(m["shards"]),
     "total_gb": round(gb, 1),
     "dev_vs_stratified_1119gb_pct": round((gb / 1119 - 1) * 100, 1),
     "dev_vs_capbound_1335gb_pct": round((gb / 1335 - 1) * 100, 1),
     "tf_pos_match_rate": round(agg["tf_pos_match_rate"], 6),
     "tok_per_s": round(agg["throughput_tok_per_s"], 0),
     "wall_h": round(agg["wall_s"] / 3600, 2),
     "peak_gpu_mem_gib": agg["peak_gpu_mem_gib"],
     "format_check_ok": fmt_ok, "format_err": fmt_err,
     "complete": bool(n_ok == 37079 and agg["n_failed"] == 0)}
json.dump(s, open(OUT / "JOB_DONE_${PBS_JOBID%%.*}.json", "w"), indent=1)
print("sentinel:", json.dumps(s))
sys.exit(0 if (${RC} == 0 and s["complete"] and fmt_ok) else 1)
PYEOF
RC2=$?
echo "=== DONE $(date) rc=${RC2} ==="
exit ${RC2}
