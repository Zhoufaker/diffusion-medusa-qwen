#!/bin/bash
# 2x2 drift attribution — Arm4: V100 + full-seq teacher forcing, 50-index panel.
# extract_ctx_features.py --audit-only --index-file (patch applied per pre-auth;
# no feature shards written, saves tf_preds.pt for the exact pairwise matrix).
#PBS -P li96
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=96GB
#PBS -l jobfs=10GB
#PBS -l walltime=00:30:00
#PBS -l storage=gdata/li96+scratch/li96
#PBS -l wd
#PBS -N drift_arm4
#PBS -o /scratch/li96/mz9869/logs/
#PBS -j oe
#PBS -m ae
#PBS -M 920928763@qq.com

set -u
module load python3/3.11.0 cuda/12.3.2
source ~/medusa-env/bin/activate
export HF_HOME=/scratch/li96/mz9869/tmp_hf_download/
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export PIP_CACHE_DIR=/scratch/li96/mz9869/tmp_pip_cache/
export EXTRACT_HARDWARE_TAG=V100-gpuvolta

cd /home/562/mz9869/medusa-qwen
echo "=== drift Arm4 V100+TF $(date) commit $(git rev-parse --short HEAD) ==="
python scripts/extract_ctx_features.py \
    --audit-only \
    --index-file /scratch/li96/mz9869/dflash_data/drift_exp/sample_indices.json \
    --out-dir /scratch/li96/mz9869/dflash_data/drift_exp/arm4_v100_tf \
    --manifest-name arm4_manifest.json
RC=$?
echo "{\"job\":\"${PBS_JOBID}\",\"arm\":\"arm4_v100_tf\",\"exit\":${RC}}" \
  > /scratch/li96/mz9869/dflash_data/drift_exp/JOB_DONE_${PBS_JOBID%%.*}.json
echo "=== DONE $(date) rc=${RC} ==="
exit ${RC}
