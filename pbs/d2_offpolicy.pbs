#!/bin/bash
# D2 off-policy 附属实验(协议预注册,~10 SU):val-500 分层
# drafter slot-1 命中率(96% on-policy 层 vs 4% off 层)。
# 与 d2_formal 同批提交(条件预授权生效后)。
#PBS -P li96
#PBS -q dgxa100
#PBS -l ncpus=16
#PBS -l ngpus=1
#PBS -l mem=150GB
#PBS -l jobfs=10GB
#PBS -l walltime=01:30:00
#PBS -l storage=gdata/li96+scratch/li96
#PBS -l wd
#PBS -N d2_offpolicy
#PBS -o /scratch/li96/mz9869/logs/
#PBS -j oe
#PBS -m ae
#PBS -M 920928763@qq.com

set -u
module load python3/3.11.0 cuda/12.3.2
source ~/medusa-env/bin/activate
export HF_HOME=/scratch/li96/mz9869/tmp_hf_download/
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export PIP_CACHE_DIR=/scratch/li96/mz9869/tmp_pip_cache/

OUT=/scratch/li96/mz9869/dflash_data/d2/offpolicy
mkdir -p ${OUT}
cd /home/562/mz9869/medusa-qwen
echo "=== D2 offpolicy aux $(date) commit $(git rev-parse --short HEAD) ==="
python scripts/d2_offpolicy_aux.py \
    --drafter-ckpt /scratch/li96/mz9869/dflash_data/drafter_ckpt_full/drafter_best_final_pinned.pt \
    --out ${OUT}/offpolicy_result.json
RC=$?
python - <<PYEOF
import json
s = {"job": "${PBS_JOBID}", "kind": "d2_offpolicy", "exit": ${RC}}
try:
    s.update(json.load(open("${OUT}/offpolicy_result.json")))
except Exception as e:
    s["result_error"] = str(e)[:200]
json.dump(s, open("${OUT}/JOB_DONE_${PBS_JOBID%%.*}.json", "w"))
print("sentinel:", s)
PYEOF
echo "=== DONE $(date) rc=${RC} ==="
exit ${RC}
