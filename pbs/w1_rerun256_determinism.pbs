#!/bin/bash
# 新门 1【抽取确定性】: rerun pilot indices 0-255 on the same hardware (A100)
# with extract code identical to pilot commit 912c798 (verify:
# git diff 912c798..HEAD -- scripts/extract_ctx_features.py is empty).
# Pass = rerun shard_00000.safetensors byte-identical to pilot's.
#PBS -P li96
#PBS -q dgxa100
#PBS -l ncpus=16
#PBS -l ngpus=1
#PBS -l mem=100GB
#PBS -l jobfs=10GB
#PBS -l walltime=00:45:00
#PBS -l storage=gdata/li96+scratch/li96
#PBS -l wd
#PBS -N w1_rerun256
#PBS -o /scratch/li96/mz9869/logs/
#PBS -j oe
#PBS -m ae
#PBS -M 920928763@qq.com

set -u
module load python3/3.11.0 cuda/12.3.2
source ~/medusa-env/bin/activate
export HF_HOME=/scratch/li96/mz9869/tmp_hf_download/
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export PIP_CACHE_DIR=/scratch/li96/mz9869/tmp_pip_cache/

cd /home/562/mz9869/medusa-qwen
echo "=== W1 determinism rerun 0-255 $(date) commit $(git rev-parse --short HEAD) ==="
python scripts/extract_ctx_features.py \
    --start-idx 0 --end-idx 256 \
    --out-dir /scratch/li96/mz9869/dflash_data/ctx_cache_35k_rerun256 \
    --manifest-name ctx_manifest_rerun256.json
RC=$?
H1=$(sha256sum /scratch/li96/mz9869/dflash_data/ctx_cache_35k_pilot/shard_00000.safetensors | awk '{print $1}')
H2=$(sha256sum /scratch/li96/mz9869/dflash_data/ctx_cache_35k_rerun256/shard_00000.safetensors | awk '{print $1}')
SAME=$([ "$H1" = "$H2" ] && echo true || echo false)
echo "pilot  sha256: $H1"
echo "rerun  sha256: $H2"
echo "byte-identical: $SAME"
echo "{\"job\":\"${PBS_JOBID}\",\"gate\":\"determinism_rerun256\",\"exit\":${RC},\"byte_identical\":${SAME},\"pilot_sha\":\"${H1}\",\"rerun_sha\":\"${H2}\"}" \
  > /scratch/li96/mz9869/dflash_data/drift_exp/JOB_DONE_${PBS_JOBID%%.*}.json
echo "=== DONE $(date) rc=${RC} ==="
exit ${RC}
