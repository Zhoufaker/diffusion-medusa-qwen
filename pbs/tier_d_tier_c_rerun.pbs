#!/bin/bash
#PBS -P li96
#PBS -q gpuvolta
#PBS -l ngpus=1,ncpus=12,mem=96GB
#PBS -l walltime=18:00:00
#PBS -l storage=gdata/li96+scratch/li96
#PBS -l wd
#PBS -N tier_d_tc
#PBS -j oe

# Tier D: Tier C rerun with per-method/block token_hash; primary=byte-identical subset.
# All paths via fail-fast env vars — see B_layer RERUN.md.

set -euo pipefail

# Log destination is supplied by the submitter (qsub -o "$MEDUSA_LOG_DIR");
# no #PBS -o here, so the script carries no site-specific log path.
: "${MEDUSA_LOG_DIR:?set MEDUSA_LOG_DIR and pass it to qsub -o}"
: "${MEDUSA_PROJECT_ROOT:?}"
: "${MEDUSA_VENV:?}"
: "${HF_HOME:?}"
: "${MEDUSA_CKPT_C1:?}"
: "${MEDUSA_MANIFEST300:?}"
: "${MEDUSA_IMAGES:?}"
: "${MEDUSA_OUT:?}"

export HF_HUB_OFFLINE="${HF_HUB_OFFLINE:-1}"
export TRANSFORMERS_OFFLINE="${TRANSFORMERS_OFFLINE:-1}"

echo "=== TIER D / TIER C RERUN $(hostname) $(date) job=${PBS_JOBID:-N/A} ==="
module load python3/3.11.0 cuda/12.3.2 2>/dev/null || true
source "${MEDUSA_VENV}/bin/activate"
cd "${MEDUSA_PROJECT_ROOT}"
mkdir -p "${MEDUSA_OUT}"

python -m pytest tests/test_max_new_cap.py -q --tb=line

python3 -u -m scripts.tier_c_interleaved_speed \
  --ckpt "${MEDUSA_CKPT_C1}" \
  --manifest "${MEDUSA_MANIFEST300}" \
  --images-dir "${MEDUSA_IMAGES}" \
  --n-prompts 300 \
  --min-ref-words 80 \
  --max-new-tokens 150 \
  --seed 42 \
  --n-blocks 3 \
  --out "${MEDUSA_OUT}/tier_c_summary.json"

echo "=== TIER D TIER-C DONE $(date) ==="
