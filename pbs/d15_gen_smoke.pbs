#!/bin/bash
# d15_gen_rollouts 冒烟(预算单既定口径,审查修订后直跑,2026-08-20 核准):
#   Phase1 bs=8 全 64 行(计时)→ Phase2 bs=1 同 64 行(计时)→
#   E = t_bs1/t_bs8 同条配对;E<1.5 = 中止信号(哨兵登记,不放全量)。
#   Phase3 断点演练:110s 时 SIGKILL 杀进程(等效 qdel 的强杀语义,
#   免 LLM 层轮询定时;替代登记)→ 重跑续跑 → 哈希优先幂等三验
#   (valid=64 / 重扫不 dirty / 二次 repair 字节不变)。
# 预算:walltime 00:50(预算单 00:40 + E 低值兜底 10min),SU 预估 ~30。
#PBS -P li96
#PBS -q dgxa100
#PBS -l ncpus=16
#PBS -l ngpus=1
#PBS -l mem=100GB
#PBS -l jobfs=10GB
#PBS -l walltime=00:50:00
#PBS -l storage=gdata/li96+scratch/li96
#PBS -l wd
#PBS -N d15_gen_smoke
#PBS -o /scratch/li96/mz9869/logs/
#PBS -j oe
#PBS -m ae
#PBS -M 920928763@qq.com

set -u
module load python3/3.11.0 cuda/12.3.2
source ~/medusa-env/bin/activate
export HF_HOME=/scratch/li96/mz9869/tmp_hf_download/
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export PIP_CACHE_DIR=/scratch/li96/mz9869/tmp_pip_cache/

SMK=/scratch/li96/mz9869/dflash_data/longform_fixed_v2/smoke_px501760
mkdir -p ${SMK}
cd /home/562/mz9869/medusa-qwen
COMMON="--limit 64 --expect-total 37079 --triplets-sha256 06b6f55b3badb739f2c10b92141ddba8784f3a4a9026107a2b44caa31b51f81f --max-pixels 501760 --max-new 512"
echo "=== d15_gen_smoke $(date) commit $(git rev-parse --short HEAD) ==="

echo "--- phase1: bs=8 full 64 ---"
python -u scripts/gen_longform_rollouts.py --out-dir ${SMK}/bs8 \
    --batch-size 8 ${COMMON} 2>&1 | tee ${SMK}/phase_bs8.log
RC1=${PIPESTATUS[0]}

echo "--- phase2: bs=1 same 64 ---"
python -u scripts/gen_longform_rollouts.py --out-dir ${SMK}/bs1 \
    --batch-size 1 ${COMMON} 2>&1 | tee ${SMK}/phase_bs1.log
RC2=${PIPESTATUS[0]}

echo "--- phase3a: drill kill @110s (expect rc=137) ---"
timeout --signal=KILL 110 \
python -u scripts/gen_longform_rollouts.py --out-dir ${SMK}/drill \
    --batch-size 8 ${COMMON} 2>&1 | tee ${SMK}/phase_drill_kill.log
RCK=${PIPESTATUS[0]}
echo "--- phase3b: drill resume to completion ---"
python -u scripts/gen_longform_rollouts.py --out-dir ${SMK}/drill \
    --batch-size 8 ${COMMON} 2>&1 | tee ${SMK}/phase_drill_resume.log
RC3=${PIPESTATUS[0]}

python - <<PYEOF
import hashlib, json, re, sys
from pathlib import Path
sys.path.append("/home/562/mz9869/medusa-qwen/scripts")
from gen_longform_rollouts import repair_and_load, scan_shard_file
SMK = Path("${SMK}")
def gen_stats(log):
    m = None
    for m in re.finditer(r"shard done: generated=(\d+) fail=(\d+) "
                         r"resume-skip=(\d+) in ([\d.]+) min", open(log).read()):
        pass
    return (None if m is None
            else dict(gen=int(m[1]), fail=int(m[2]), skip=int(m[3]),
                      minutes=float(m[4])))
bs8 = gen_stats(SMK / "phase_bs8.log")
bs1 = gen_stats(SMK / "phase_bs1.log")
res = gen_stats(SMK / "phase_drill_resume.log")
E = R8 = R1 = gpuh = su = None
if bs8 and bs1 and bs8["minutes"] > 0 and bs1["minutes"] > 0:
    R8 = 64 / (bs8["minutes"] * 60)
    R1 = 64 / (bs1["minutes"] * 60)
    E = bs1["minutes"] / bs8["minutes"]
    gpuh = 37079 / (0.0958 * E * 3600)   # 全量外推:R1_pilot × E(预算口径)
    su = gpuh * 72
fp = SMK / "drill" / "rollouts_shard_00000.jsonl"
sha_a = hashlib.sha256(fp.read_bytes()).hexdigest() if fp.exists() else None
done = repair_and_load(fp) if fp.exists() else set()
sha_b = hashlib.sha256(fp.read_bytes()).hexdigest() if fp.exists() else None
valid, dirty = scan_shard_file(fp) if fp.exists() else ([], True)
drill_ok = (len(done) == 64 and not dirty and sha_a == sha_b)
s = {"job": "${PBS_JOBID}", "kind": "d15_gen_smoke",
     "rc": {"bs8": ${RC1}, "bs1": ${RC2}, "kill": ${RCK}, "resume": ${RC3}},
     "bs8": bs8, "bs1": bs1,
     "R_bs8_rows_per_s": None if R8 is None else round(R8, 4),
     "R_bs1_rows_per_s": None if R1 is None else round(R1, 4),
     "E_paired": None if E is None else round(E, 2),
     "e_gate_ge_1p5": None if E is None else bool(E >= 1.5),
     "full_extrapolation": None if E is None else
        {"gpu_h": round(gpuh, 1), "su": round(su, 0),
         "formula": "37079/(0.0958*E*3600)*72"},
     "drill": {"kill_rc_expect_137": ${RCK},
               "resume_pre_skip": None if res is None else res["skip"],
               "final_valid": len(done), "rescan_dirty": bool(dirty),
               "repair_idempotent_sha_unchanged": bool(sha_a == sha_b),
               "drill_ok": bool(drill_ok)}}
json.dump(s, open(SMK / "JOB_DONE_${PBS_JOBID%%.*}.json", "w"), indent=1)
print("sentinel:", json.dumps(s))
ok = (${RC1} == 0 and ${RC2} == 0 and ${RC3} == 0 and drill_ok
      and bs8 and bs8["gen"] + bs8["skip"] >= 64
      and bs1 and bs1["gen"] + bs1["skip"] >= 64)
sys.exit(0 if ok else 1)
PYEOF
RC=$?
echo "=== DONE $(date) rc=${RC} ==="
exit ${RC}
