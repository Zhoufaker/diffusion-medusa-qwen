#!/bin/bash
# longform_fixed_v2 全链 copyq 编排(用户特批 2026-08-19):
# 续传 VG/LN 下载 → SP 解取+LN 采样下载(copyq 有外网)→ 四源固定 →
# 元数据 tar → 哨兵。copyq:1 核、无 30min CPU 限制、外网可达。
#PBS -P li96
#PBS -q copyq
#PBS -l ncpus=1
#PBS -l mem=32GB
#PBS -l walltime=08:00:00
#PBS -l storage=gdata/li96+scratch/li96
#PBS -l wd
#PBS -N d15_v2_chain
#PBS -o /scratch/li96/mz9869/logs/
#PBS -j oe
#PBS -m ae
#PBS -M 920928763@qq.com

set -u
module load python3/3.11.0
source ~/medusa-env/bin/activate
export HF_HOME=/scratch/li96/mz9869/tmp_hf_download/
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export PIP_CACHE_DIR=/scratch/li96/mz9869/tmp_pip_cache/
export TOKENIZERS_PARALLELISM=false

S=/scratch/li96/mz9869/dflash_data/longform_fixed_v2/staging
V2=/scratch/li96/mz9869/dflash_data/longform_fixed_v2
cd /home/562/mz9869/medusa-qwen
echo "=== v2 chain $(date) commit $(git rev-parse --short HEAD) ==="

echo "--- step1 下载续传 ---"
cd $S/vg && wget -c -q https://cs.stanford.edu/people/rak248/VG_100K/images.zip \
  https://cs.stanford.edu/people/rak248/VG_100K_2/images2.zip
cd $S/ln 2>/dev/null || mkdir -p $S/ln && cd $S/ln
wget -c -q https://storage.googleapis.com/localized-narratives/annotations/open_images_train_v6_captions.jsonl
echo "downloads done $(date)"

echo "--- step2 SP/LN 预备 ---"
cd /home/562/mz9869/medusa-qwen
python scripts/prep_v2_sources.py
RC1=$?

echo "--- step3 四源固定(干净重建:清除既有产物防混装) ---"
rm -f $V2/triplets.jsonl $V2/manifest.json $V2/images/shard_*.tar
python scripts/fix_longform_data.py \
    --staging $S/docci \
    --out $V2 \
    --sources docci,detailcaps,sp,ln
RC2=$?

echo "--- step4 元数据 tar ---"
cd $V2 && tar -czf /scratch/li96/mz9869/archives/longform_fixed_v2_meta.tar.gz \
    triplets.jsonl manifest.json
SHA=$(sha256sum /scratch/li96/mz9869/archives/longform_fixed_v2_meta.tar.gz | awk '{print $1}')

python - <<PYEOF
import json
s = {"job": "${PBS_JOBID}", "kind": "d15_v2_chain",
     "exit_prep": ${RC1}, "exit_fix": ${RC2}, "meta_tar_sha256": "${SHA}"}
try:
    m = json.load(open("${V2}/manifest.json"))
    s.update(n_total=m["n_total"], shards=len(m["shards"]),
             per_source={k: v.get("fixed") for k, v in m["per_source"].items()},
             dup_eval={k: v.get("dup_eval") for k, v in m["per_source"].items()})
except Exception as e:
    s["manifest_error"] = str(e)[:200]
json.dump(s, open("${V2}/JOB_DONE_${PBS_JOBID%%.*}.json", "w"), indent=1)
print("sentinel:", s)
PYEOF
echo "=== DONE $(date) rc=${RC1}/${RC2} ==="
exit $(( RC1 > RC2 ? RC1 : RC2 ))
