#!/bin/bash
#PBS -N linked_medusa_v1_full
#PBS -P li96
#PBS -q gpuvolta
#PBS -l storage=gdata/li96+scratch/li96
#PBS -l ncpus=12
#PBS -l mem=96GB
#PBS -l ngpus=1
#PBS -l walltime=04:00:00
#PBS -l wd
#PBS -j oe
#PBS -o /scratch/li96/mz9869/logs/

# Linked Medusa v1 — full training on NCI Gadi V100.
# Spec ref: linked_medusa_spec.md §9.3.
#
# Production hyperparameters (baked into this script; YAML defaults are
# development-friendly):
#   - dataset.kind       = cached  (real Qwen2.5-VL hidden+token cache)
#   - dataset.eval_split = last_2000 (numeric-stem reproducible split)
#   - training.total_steps = 11650  (~1 epoch on 44614 train samples / bs=4)
#   - logging.log_every  = 50       (every ~2 min on V100, 233 lines total)
#   - logging.eval_every = 500      (23 evals × ~3 min = ~70 min eval cost)
#   - logging.save_every = 1000     (12 step ckpts, keep_recent_n=3)
#   - logging.output_dir = .../linked_medusa_v1_full
#
# Walltime budget (4 hours):
#   - train forward/backward at ips~2.7 = 11650/2.7 = ~72 min
#   - 23 evals × (2000/bs=4 = 500 batches × ~0.4s) = ~70 min
#   - ckpt I/O + misc = ~5 min
#   - margin: ~30 min
#
# Submit:
#     qsub pbs/train_v100.pbs
#
# Optional extra CLI overrides via $EXTRA_OVERRIDES env var, e.g.
#     qsub -v EXTRA_OVERRIDES="training.batch_size=8 training.lr=3e-4" pbs/train_v100.pbs

set -euo pipefail

echo "=== JOB METADATA ==="
echo "PBS_JOBID    = ${PBS_JOBID:-unset}"
echo "PBS_O_HOST   = ${PBS_O_HOST:-unset}"
echo "PBS_O_WORKDIR= ${PBS_O_WORKDIR:-unset}"
echo "hostname     = $(hostname)"
echo "date         = $(date)"
nvidia-smi --query-gpu=name,memory.total,driver_version --format=csv,noheader | head -1
echo

module load python3/3.11.0 cuda/12.3.2
source ~/medusa-env/bin/activate

cd ~/medusa-qwen
echo "=== environment ==="
python --version
python -c "import torch; print('torch', torch.__version__, 'cuda', torch.cuda.is_available())"
python -c "import bitsandbytes; print('bitsandbytes', bitsandbytes.__version__)"
echo

CONFIG=${CONFIG:-config/linked_medusa_default.yaml}
EXTRA_OVERRIDES=${EXTRA_OVERRIDES:-}

# Production overrides — keep in lockstep with the comment block above.
PROD_OVERRIDES=(
    dataset.kind=cached
    dataset.eval_split=last_2000
    training.total_steps=11650
    logging.log_every=50
    logging.eval_every=500
    logging.save_every=1000
    logging.output_dir=/scratch/li96/mz9869/medusa_outputs/linked_medusa_v1_full
)

echo "=== launch ==="
echo "config              : $CONFIG"
echo "production overrides: ${PROD_OVERRIDES[*]}"
echo "extra overrides     : $EXTRA_OVERRIDES"
echo

# shellcheck disable=SC2086
python -u -m scripts.train --config "$CONFIG" --override "${PROD_OVERRIDES[@]}" $EXTRA_OVERRIDES
