#!/bin/bash
# D1.5 rollout pilot 重跑——PREPROCESS_SPEC max_pixels=501760(2026-08-20 裁决)。
# 免审档(用户核准):同模板(d15_rollout_pilot.pbs)同预算,仅换输入清单
# (prep 适配层预缩放 cap-bound 图像)+输出目录+作业名。
# gen_cache_rollout.py 依旧【零改动】;同 50 条同 seed;max_new 512 上限
# 照旧,按原预注册规则对新数据重裁(逻辑内置哨兵,无人工干预)。
#PBS -P li96
#PBS -q dgxa100
#PBS -l ncpus=16
#PBS -l ngpus=1
#PBS -l mem=100GB
#PBS -l jobfs=10GB
#PBS -l walltime=00:30:00
#PBS -l storage=gdata/li96+scratch/li96
#PBS -l wd
#PBS -N d15_rollout_pilot_px
#PBS -o /scratch/li96/mz9869/logs/
#PBS -j oe
#PBS -m ae
#PBS -M 920928763@qq.com

set -u
module load python3/3.11.0 cuda/12.3.2
source ~/medusa-env/bin/activate
export HF_HOME=/scratch/li96/mz9869/tmp_hf_download/
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export PIP_CACHE_DIR=/scratch/li96/mz9869/tmp_pip_cache/

P=/scratch/li96/mz9869/dflash_data/longform_fixed_v2/pilot
PROMPTS=${P}/pilot_prompts_px501760.json
IMGDIR=${P}/images_px501760
OUT=${P}/rollout512_px501760
mkdir -p ${OUT}
cd /home/562/mz9869/medusa-qwen
echo "=== D1.5 rollout pilot px501760 $(date) commit $(git rev-parse --short HEAD) ==="
python scripts/gen_cache_rollout.py \
    --prompts ${PROMPTS} \
    --images-dir ${IMGDIR} \
    --out-dir ${OUT} \
    --max-new 512
RC=$?
python - <<PYEOF
import json, glob, statistics as st, sys
import torch
sys.path.insert(0, "/home/562/mz9869/medusa-qwen")
from decode.common import make_image_inputs
from transformers import AutoProcessor, AutoTokenizer
from pathlib import Path
prompts = json.load(open("${PROMPTS}"))
# id = sample_id 的 '/'→'_':docci_… / detailcaps_… / sp_… / ln_…,源名=首段
src_of = {p["id"]: p["id"].split("_")[0] for p in prompts}
proc = AutoProcessor.from_pretrained("Qwen/Qwen2.5-VL-7B-Instruct")
Ts = []
stats = {}
for i, p in enumerate(prompts):
    fp = Path("${OUT}") / f"{i}.pt"
    if not fp.exists():
        continue
    L = int(torch.load(fp, map_location="cpu", weights_only=True)["tokens"].shape[0])
    P_len = make_image_inputs(proc, p["question"],
                              Path("${IMGDIR}") / p["image"], "cpu")["input_ids"].shape[1]
    Ts.append(P_len + L)
    stats.setdefault(src_of[p["id"]], []).append(L)
def agg(Ls):
    Ls = sorted(Ls); n = len(Ls)
    return {"n": n, "mean": round(st.mean(Ls), 1), "med": Ls[n // 2],
            "p90": Ls[min(n - 1, 9 * n // 10)], "max": Ls[-1],
            "trunc_at_384": round(sum(1 for x in Ls if x >= 384) / n, 3),
            "trunc_at_512": round(sum(1 for x in Ls if x >= 512) / n, 3)}
per_source = {k: agg(v) for k, v in stats.items()}
pooled = agg([x for v in stats.values() for x in v])
worst384 = max(v["trunc_at_384"] for v in per_source.values())
decision = 384 if worst384 <= 0.05 else 512
T_mean = st.mean(Ts)
cache_gb = 37079 * T_mean * 5 * 3584 * 2 / 1e9
s = {"job": "${PBS_JOBID}", "kind": "d15_rollout_pilot_px501760", "exit": ${RC},
     "preprocess_spec_max_pixels": 501760,
     "per_source": per_source, "pooled": pooled,
     "worst_source_trunc_at_384": worst384,
     "max_new_decision_prereg": decision,
     "full_seq_mean_T": round(T_mean, 1),
     "feature_cache_extrapolation_37k_gb": round(cache_gb, 1)}
json.dump(s, open("${OUT}/JOB_DONE_${PBS_JOBID%%.*}.json", "w"), indent=1)
print("sentinel:", json.dumps(s)[:800])
# 每源各 1 条样例全文
tk = AutoTokenizer.from_pretrained("Qwen/Qwen2.5-VL-7B-Instruct")
seen = set()
with open("${OUT}/samples_for_review.txt", "w") as fo:
    for i, p in enumerate(prompts):
        srcname = src_of[p["id"]]
        fp = Path("${OUT}") / f"{i}.pt"
        if srcname in seen or not fp.exists():
            continue
        seen.add(srcname)
        toks = torch.load(fp, map_location="cpu", weights_only=True)["tokens"]
        fo.write(f"===== [{srcname}] {p['id']} ({toks.shape[0]} tok) =====\n")
        fo.write(tk.decode(toks.tolist()) + "\n\n")
print("samples (1/source) -> ${OUT}/samples_for_review.txt")
PYEOF
echo "=== DONE $(date) rc=${RC} ==="
exit ${RC}
