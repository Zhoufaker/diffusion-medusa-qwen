#!/bin/bash
# D1.5 v2 批量 rollout 生成(37,079 条)——【必审档,发审查,未获批不 qsub】
# 预算已按 px 重跑 pilot(176694274)实测回填:R1=0.0958 row/s,E=3 保守
# 外推 35.8 GPU·h / 2,581 SU;walltime 7h/shard(含 1.5 安全系数)。
# 预算全文见 reports/d15_gen_rollouts_budget.md(整包送审)。
# 结构参考 6 月 8-shard 模板(gen_cache_full.pbs);差异(登记):
#   - 连续区间分片(tar 局部性)而非 idx%K;
#   - 输出为逐 shard JSONL(inode 纪律)而非 37K 散 .pt;
#   - 批量 generate(bs 可配)+ 三处谱系口径对齐(见脚本 docstring)。
# 收尾:全部 array 子作业完成后在【登录节点】跑
#   python scripts/gen_longform_rollouts.py --out-dir <OUT> --manifest-only
#PBS -P li96
#PBS -q dgxa100
#PBS -l ncpus=16
#PBS -l ngpus=1
#PBS -l mem=100GB
#PBS -l jobfs=10GB
#PBS -l walltime=07:00:00
#PBS -l storage=gdata/li96+scratch/li96
#PBS -l wd
#PBS -N d15_gen_rollouts
#PBS -o /scratch/li96/mz9869/logs/
#PBS -j oe
#PBS -m ae
#PBS -M 920928763@qq.com
#PBS -r y
#PBS -J 0-7

set -u
module load python3/3.11.0 cuda/12.3.2
source ~/medusa-env/bin/activate
export HF_HOME=/scratch/li96/mz9869/tmp_hf_download/
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export PIP_CACHE_DIR=/scratch/li96/mz9869/tmp_pip_cache/

NUM_SHARDS=8
SHARD_ID=${PBS_ARRAY_INDEX:-0}
BS=8
OUT=/scratch/li96/mz9869/dflash_data/longform_fixed_v2/rollouts_px501760
mkdir -p ${OUT}
cd /home/562/mz9869/medusa-qwen
echo "=== d15_gen_rollouts shard ${SHARD_ID}/${NUM_SHARDS} $(hostname) $(date) commit $(git rev-parse --short HEAD) ==="
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader | head -1

python -u scripts/gen_longform_rollouts.py \
    --out-dir ${OUT} \
    --max-pixels 501760 \
    --max-new 512 \
    --batch-size ${BS} \
    --shard-id ${SHARD_ID} \
    --num-shards ${NUM_SHARDS}
RC=$?

# 逐子作业哨兵(汇总本 shard 文件实态,哈希优先口径)
python - <<PYEOF
import json, sys
sys.path.append("/home/562/mz9869/medusa-qwen/scripts")
from gen_longform_rollouts import scan_shard_file, shard_range
sid = int("${SHARD_ID}")
valid, dirty = scan_shard_file(f"${OUT}/rollouts_shard_{sid:05d}.jsonl")
rng = shard_range(37079, ${NUM_SHARDS}, sid)
s = {"job": "${PBS_JOBID}", "kind": "d15_gen_rollouts_shard", "exit": ${RC},
     "shard": ${SHARD_ID}, "rows": [rng.start, rng.stop],
     "n_valid": len(valid), "n_expected": len(rng), "dirty_seen": bool(dirty),
     "complete": len(valid) >= len(rng)}
json.dump(s, open("${OUT}/JOB_DONE_${PBS_JOBID%%.*}.json", "w"), indent=1)
print("sentinel:", json.dumps(s))
PYEOF
echo "=== shard ${SHARD_ID} DONE $(date) rc=${RC} ==="
exit ${RC}
