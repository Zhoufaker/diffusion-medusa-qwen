#!/bin/bash
#PBS -P li96
#PBS -q gpuvolta
#PBS -l ngpus=1,ncpus=12,mem=96GB
#PBS -l walltime=06:00:00
#PBS -l storage=gdata/li96+scratch/li96
#PBS -l wd
#PBS -N diag_3a_iso
#PBS -j oe
#PBS -o /scratch/li96/mz9869/logs/

# 3a process-isolated h-dump (9 remaining) + CPU top-3 + MM-Vet item5 one-shots.

set -euo pipefail
export HF_HOME=/scratch/li96/mz9869/tmp_hf_download
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1

PROJECT_ROOT="${HOME}/medusa-qwen"
VENV="${HOME}/medusa-env"
OUT=/scratch/li96/mz9869/medusa_outputs/linked_medusa_c1_eagle/diag_triad

echo "=== 3a PROCESS-ISOLATED $(hostname) $(date) job=${PBS_JOBID:-N/A} ==="
module load python3/3.11.0 cuda/12.3.2 2>/dev/null || true
source "${VENV}/bin/activate"
cd "${PROJECT_ROOT}"
mkdir -p "$OUT/item3_h_fp16" /scratch/li96/mz9869/logs

# 9 remaining (055049 already passed)
python3 - <<'PY' > /tmp/item3_todo.txt
import json
audit=json.load(open("/scratch/li96/mz9869/medusa_outputs/linked_medusa_c1_eagle/diag_triad/item3_fp32_audit.json"))
skip="000000055049"
for r in audit:
    if r["prompt_id"]==skip: continue
    print(f"{r['prompt_id']} {r['pos']}")
PY

while read -r PID POS; do
  echo ""
  echo "######## ONE-PROC $PID pos=$POS ########"
  python3 -u -m scripts.diag_item3_h_dump_one \
    --prompt-id "$PID" --pos "$POS" --out-dir "$OUT" \
    || echo "FAIL $PID pos=$POS exit=$?"
done < /tmp/item3_todo.txt

echo ""
echo "=== CPU top-3 ==="
python3 -u -m scripts.diag_item3_top3_cpu --out-dir "$OUT" || true

echo ""
echo "=== item5 MM-Vet mem one-shots ==="
for PX in 501760 1003520; do
  for IMG in v1_82.png v1_21.png; do
    echo "---- mem $IMG px=$PX ----"
    python3 -u -m scripts.diag_item5_mem \
      --max-pixels "$PX" \
      --image "/scratch/li96/mz9869/ood_eval/mmvet/mm-vet/images/$IMG" \
      --out "$OUT/item5_mem_${IMG%.png}_${PX}.json" \
      || echo "item5 FAIL $IMG $PX"
  done
done

echo "=== DONE $(date) ==="
