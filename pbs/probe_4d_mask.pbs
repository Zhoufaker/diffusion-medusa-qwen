#!/bin/bash
#PBS -P li96
#PBS -q gpuvolta
#PBS -l ngpus=1,ncpus=12,mem=64GB
#PBS -l walltime=00:20:00
#PBS -l storage=gdata/li96+scratch/li96
#PBS -l wd
#PBS -N probe_4d_mask
#PBS -j oe
#PBS -o /scratch/li96/mz9869/medusa_outputs/probe_4d_mask.log

set -euo pipefail

PROJECT_ROOT="${HOME}/medusa-qwen"
VENV="${HOME}/medusa-env"

echo "================================================================"
echo "4D custom attention mask probe (Qwen2.5-VL, transformers 5.3.0)"
echo "host: $(hostname)   date: $(date)   job: ${PBS_JOBID:-N/A}"
echo "================================================================"

module load python3/3.11.0 cuda/12.3.2 2>/dev/null || true
source "${VENV}/bin/activate"
echo "[env] torch: $(python3 -c 'import torch; print(torch.__version__, torch.cuda.is_available())')"
echo "[env] transformers: $(python3 -c 'import transformers; print(transformers.__version__)')"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader

cd "${PROJECT_ROOT}"
python3 -u -m scripts.probe_4d_mask
echo "EXIT_CODE=$?"
echo "DONE $(date)"
