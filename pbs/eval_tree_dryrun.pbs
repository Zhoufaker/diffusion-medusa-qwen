#!/bin/bash
#PBS -P li96
#PBS -q gpuvolta
#PBS -l ngpus=1,ncpus=12,mem=64GB
#PBS -l walltime=00:30:00
#PBS -l storage=gdata/li96+scratch/li96
#PBS -l wd
#PBS -N eval_tree_dryrun
#PBS -j oe
#PBS -o /scratch/li96/mz9869/medusa_outputs/eval_tree_dryrun.log

set -euo pipefail
PROJECT_ROOT="${HOME}/medusa-qwen"
VENV="${HOME}/medusa-env"
echo "================================================================"
echo "TREE DRY-RUN: fanout=[4,3,2] max_nodes=16 reorg=gather (width>1 path)"
echo "host: $(hostname)   date: $(date)   job: ${PBS_JOBID:-N/A}"
echo "================================================================"
module load python3/3.11.0 cuda/12.3.2 2>/dev/null || true
source "${VENV}/bin/activate"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader
cd "${PROJECT_ROOT}"
python3 -u -m scripts.eval_acceptance_tree \
  --mode tree \
  --reorg gather \
  --fanout 4 3 2 \
  --max-nodes 16 \
  --n-prompts 5 \
  --max-new-tokens 80 \
  --measure-greedy \
  --out /scratch/li96/mz9869/medusa_outputs/linked_medusa_v1_full/eval_acceptance_tree_dryrun.json
echo "EXIT_CODE=$?"
echo "DONE $(date)"
