#!/bin/bash
#PBS -P li96
#PBS -q gpuvolta
#PBS -l ngpus=1,ncpus=12,mem=96GB
#PBS -l walltime=18:00:00
#PBS -l storage=gdata/li96+scratch/li96
#PBS -l wd
#PBS -N v2_in_domain
#PBS -j oe

# v2 hardcap + dual-verdict O0 rebaseline (in-domain).
# All paths via fail-fast env vars — see B_layer RERUN.md.

set -euo pipefail

# Log destination is supplied by the submitter (qsub -o "$MEDUSA_LOG_DIR");
# no #PBS -o here, so the script carries no site-specific log path.
: "${MEDUSA_LOG_DIR:?set MEDUSA_LOG_DIR and pass it to qsub -o}"
: "${MEDUSA_PROJECT_ROOT:?}"
: "${MEDUSA_VENV:?}"
: "${HF_HOME:?}"
: "${MEDUSA_CKPT_C1:?}"
: "${MEDUSA_CKPT_B2:?}"
: "${MEDUSA_MANIFEST100:?}"
: "${MEDUSA_MANIFEST300:?}"
: "${MEDUSA_IMAGES:?}"
: "${MEDUSA_OUT:?}"

export HF_HUB_OFFLINE="${HF_HUB_OFFLINE:-1}"
export TRANSFORMERS_OFFLINE="${TRANSFORMERS_OFFLINE:-1}"

echo "=== V2 IN-DOMAIN $(hostname) $(date) job=${PBS_JOBID:-N/A} ==="
module load python3/3.11.0 cuda/12.3.2 2>/dev/null || true
source "${MEDUSA_VENV}/bin/activate"
cd "${MEDUSA_PROJECT_ROOT}"
mkdir -p "${MEDUSA_OUT}"

python -m pytest tests/test_o0_and_ordered.py tests/test_max_new_cap.py -q --tb=line

COMMON100="--mode tree --fold-bonus --reorg gather --n-prompts 100 --min-ref-words 80 \
  --max-new-tokens 150 --seed 42 --check-greedy-bytes \
  --manifest ${MEDUSA_MANIFEST100} --images-dir ${MEDUSA_IMAGES}"
COMMON300="--mode tree --fold-bonus --reorg gather --n-prompts 300 --min-ref-words 80 \
  --max-new-tokens 150 --seed 42 --ordered-manifest --check-greedy-bytes \
  --manifest ${MEDUSA_MANIFEST300} --images-dir ${MEDUSA_IMAGES}"

run () {
  local tag=$1; shift
  echo ""; echo "######## $tag ########"
  python3 -u -m scripts.eval_acceptance_tree "$@" \
    --out "${MEDUSA_OUT}/${tag}.json" \
    --o0-write-archive "${MEDUSA_OUT}/${tag}.spec_archive.json" \
    --o0-write-greedy-archive "${MEDUSA_OUT}/${tag}.greedy_archive.json"
}

run gate100_c1_d3 --tree-builder static --ckpt "${MEDUSA_CKPT_C1}" \
  $COMMON100 --fanout 1 3 2 1 0 --max-nodes 16
run gate100_c1_6432 --tree-builder static --ckpt "${MEDUSA_CKPT_C1}" \
  $COMMON100 --fanout 1 6 4 3 2 --max-nodes 32
run gate100_b2_wide --tree-builder static --ckpt "${MEDUSA_CKPT_B2}" \
  $COMMON100 --fanout 1 6 4 2 1 --max-nodes 24

run bridge300_c1_d3 --tree-builder static --ckpt "${MEDUSA_CKPT_C1}" \
  $COMMON300 --fanout 1 3 2 1 0 --max-nodes 16
run bridge300_c1_6432 --tree-builder static --ckpt "${MEDUSA_CKPT_C1}" \
  $COMMON300 --fanout 1 6 4 3 2 --max-nodes 32
run bridge300_b2_d3 --tree-builder static --ckpt "${MEDUSA_CKPT_B2}" \
  $COMMON300 --fanout 1 3 2 1 0 --max-nodes 16
run bridge300_b2_6432 --tree-builder static --ckpt "${MEDUSA_CKPT_B2}" \
  $COMMON300 --fanout 1 6 4 3 2 --max-nodes 32

run dyn_k8_n24 --tree-builder dynamic --ckpt "${MEDUSA_CKPT_C1}" \
  $COMMON300 --fanout 1 8 8 8 8 --max-nodes 24
run dyn_k8_n32 --tree-builder dynamic --ckpt "${MEDUSA_CKPT_C1}" \
  $COMMON300 --fanout 1 8 8 8 8 --max-nodes 32

echo "=== V2 IN-DOMAIN DONE $(date) ==="
