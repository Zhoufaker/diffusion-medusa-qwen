#!/bin/bash
#PBS -P li96
#PBS -q gpuvolta
#PBS -l ngpus=1,ncpus=12,mem=96GB
#PBS -l walltime=18:00:00
#PBS -l storage=gdata/li96+scratch/li96
#PBS -l wd
#PBS -N tier_d_repro
#PBS -j oe

# Tier D: full-coverage archive reproducibility vs frozen v2 anchors.
# All paths via fail-fast env vars — see B_layer RERUN.md.

set -euo pipefail

# Log destination is supplied by the submitter (qsub -o "$MEDUSA_LOG_DIR");
# no #PBS -o here, so the script carries no site-specific log path.
: "${MEDUSA_LOG_DIR:?set MEDUSA_LOG_DIR and pass it to qsub -o}"
: "${MEDUSA_PROJECT_ROOT:?}"
: "${MEDUSA_VENV:?}"
: "${HF_HOME:?}"
: "${MEDUSA_CKPT_C1:?}"
: "${MEDUSA_CKPT_B2:?}"
: "${MEDUSA_MANIFEST100:?}"
: "${MEDUSA_MANIFEST300:?}"
: "${MEDUSA_MANIFEST_OOD:?}"
: "${MEDUSA_IMAGES:?}"
: "${MEDUSA_IMAGES_OOD:?}"
: "${MEDUSA_ANCHOR:?}"
: "${MEDUSA_OUT:?}"

export HF_HUB_OFFLINE="${HF_HUB_OFFLINE:-1}"
export TRANSFORMERS_OFFLINE="${TRANSFORMERS_OFFLINE:-1}"

echo "=== TIER D REPRO FULLCOVER $(hostname) $(date) job=${PBS_JOBID:-N/A} ==="
module load python3/3.11.0 cuda/12.3.2 2>/dev/null || true
source "${MEDUSA_VENV}/bin/activate"
cd "${MEDUSA_PROJECT_ROOT}"
mkdir -p "${MEDUSA_OUT}"

python -m pytest tests/test_o0_and_ordered.py tests/test_max_new_cap.py -q --tb=line

COMMON100="--mode tree --fold-bonus --reorg gather --n-prompts 100 --min-ref-words 80 \
  --max-new-tokens 150 --seed 42 --check-greedy-bytes \
  --manifest ${MEDUSA_MANIFEST100} --images-dir ${MEDUSA_IMAGES}"
COMMON300="--mode tree --fold-bonus --reorg gather --n-prompts 300 --min-ref-words 80 \
  --max-new-tokens 150 --seed 42 --ordered-manifest --check-greedy-bytes \
  --manifest ${MEDUSA_MANIFEST300} --images-dir ${MEDUSA_IMAGES}"
COMMON_OOD="--mode tree --fold-bonus --reorg gather --n-prompts 218 --min-ref-words 0 \
  --max-new-tokens 150 --seed 42 --ordered-manifest --check-greedy-bytes \
  --max-pixels 501760 --manifest ${MEDUSA_MANIFEST_OOD} --images-dir ${MEDUSA_IMAGES_OOD}"

run_anchor () {
  local tag=$1; shift
  local arch="${MEDUSA_ANCHOR}/${tag}.spec_archive.json"
  echo ""; echo "######## REPRO $tag vs $arch ########"
  test -f "$arch" || { echo "MISSING ANCHOR $arch"; exit 1; }
  python3 -u -m scripts.eval_acceptance_tree "$@" \
    --check-greedy-bytes \
    --o0-archive "$arch" \
    --out "${MEDUSA_OUT}/${tag}.json"
}

run_anchor gate100_c1_d3 --tree-builder static --ckpt "${MEDUSA_CKPT_C1}" \
  $COMMON100 --fanout 1 3 2 1 0 --max-nodes 16
run_anchor gate100_c1_6432 --tree-builder static --ckpt "${MEDUSA_CKPT_C1}" \
  $COMMON100 --fanout 1 6 4 3 2 --max-nodes 32
run_anchor gate100_b2_wide --tree-builder static --ckpt "${MEDUSA_CKPT_B2}" \
  $COMMON100 --fanout 1 6 4 2 1 --max-nodes 24

run_anchor bridge300_c1_d3 --tree-builder static --ckpt "${MEDUSA_CKPT_C1}" \
  $COMMON300 --fanout 1 3 2 1 0 --max-nodes 16
run_anchor bridge300_c1_6432 --tree-builder static --ckpt "${MEDUSA_CKPT_C1}" \
  $COMMON300 --fanout 1 6 4 3 2 --max-nodes 32
run_anchor bridge300_b2_d3 --tree-builder static --ckpt "${MEDUSA_CKPT_B2}" \
  $COMMON300 --fanout 1 3 2 1 0 --max-nodes 16
run_anchor bridge300_b2_6432 --tree-builder static --ckpt "${MEDUSA_CKPT_B2}" \
  $COMMON300 --fanout 1 6 4 3 2 --max-nodes 32

run_anchor dyn_k8_n24 --tree-builder dynamic --ckpt "${MEDUSA_CKPT_C1}" \
  $COMMON300 --fanout 1 8 8 8 8 --max-nodes 24
run_anchor dyn_k8_n32 --tree-builder dynamic --ckpt "${MEDUSA_CKPT_C1}" \
  $COMMON300 --fanout 1 8 8 8 8 --max-nodes 32

run_anchor O1_c1_d3 --tree-builder static --ckpt "${MEDUSA_CKPT_C1}" \
  $COMMON_OOD --fanout 1 3 2 1 0 --max-nodes 16
run_anchor O2_c1_6432 --tree-builder static --ckpt "${MEDUSA_CKPT_C1}" \
  $COMMON_OOD --fanout 1 6 4 3 2 --max-nodes 32
run_anchor O3_b2_d3 --tree-builder static --ckpt "${MEDUSA_CKPT_B2}" \
  $COMMON_OOD --fanout 1 3 2 1 0 --max-nodes 16
run_anchor O4_b2_6432 --tree-builder static --ckpt "${MEDUSA_CKPT_B2}" \
  $COMMON_OOD --fanout 1 6 4 3 2 --max-nodes 32

python3 - <<'EOF'
import json, os, sys
from pathlib import Path

# Take the claim from the classifier that produced these verdicts; a copy
# pasted here would silently outlive the next predicate change.
from decode.common import O0_CLAIM_OFFICIAL
OUT = Path(os.environ["MEDUSA_OUT"])
ANCHOR = os.environ["MEDUSA_ANCHOR"]
tags = [
    "gate100_c1_d3","gate100_c1_6432","gate100_b2_wide",
    "bridge300_c1_d3","bridge300_c1_6432","bridge300_b2_d3","bridge300_b2_6432",
    "dyn_k8_n24","dyn_k8_n32",
    "O1_c1_d3","O2_c1_6432","O3_b2_d3","O4_b2_6432",
]
rows, stops = {}, []
print(f"{'tag':24s} {'arch':10s} {'byte':5s} {'safe':5s} {'cover':6s} {'exact':5s} {'near':5s}")
for tag in tags:
    rep = json.load(open(OUT / f"{tag}.o0_report.json", encoding="utf-8"))
    st = rep["archive_gate_status"]
    be = rep["greedy_byte_exact_pass"]
    sf = rep["greedy_numerical_safety_pass"]
    rows[tag] = {
        "archive_gate_status": st,
        "greedy_byte_exact_pass": be,
        "greedy_numerical_safety_pass": sf,
        "n_archive_covered": rep["n_archive_covered"],
        "n_prompts": rep["n_prompts"],
        "n_exact": rep["n_exact"],
        "n_near_tie": rep["n_near_tie"],
        "n_len_boundary": rep["n_len_boundary"],
        "n_hard": rep["n_hard"],
    }
    print(f"{tag:24s} {st:10s} {str(be):5s} {str(sf):5s} "
          f"{rep['n_archive_covered']:6d} {rep['n_exact']:5d} {rep['n_near_tie']:5d}")
    if st != "PASS":
        stops.append(f"{tag}: archive_gate={st} (need full-coverage PASS)")
    if not sf:
        stops.append(f"{tag}: numerical_safety FAIL")
summary = {
    "job": os.environ.get("PBS_JOBID"),
    "protocol": "tier_d_fullcover_repro",
    "anchor": ANCHOR,
    "rows": rows,
    "stops": stops,
    "overall": "FAIL" if stops else "PASS_FULLCOVER_REPRO",
    "official_claim": O0_CLAIM_OFFICIAL,
}
json.dump(summary, open(OUT / "repro_summary.json", "w", encoding="utf-8"), indent=2)
print("\nOVERALL:", summary["overall"])
for s in stops:
    print(" STOP:", s)
sys.exit(1 if stops else 0)
EOF

echo "=== TIER D REPRO DONE $(date) ==="
