#!/bin/bash
#PBS -P li96
#PBS -q gpuvolta
#PBS -l ngpus=1,ncpus=12,mem=96GB
#PBS -l walltime=05:00:00
#PBS -l storage=gdata/li96+scratch/li96
#PBS -l wd
#PBS -N ood_mmvet
#PBS -j oe
#PBS -o /scratch/li96/mz9869/logs/

# Part A: OOD MM-Vet full 218 + LLaVA-Bench gate rows G1-G3.
# G*: old 100 via legacy filter/shuffle (bit-exact σ anchors).
# O*: MM-Vet 218 ordered; O0 = --check-greedy-bytes (218/218).

set -euo pipefail
export HF_HOME=/scratch/li96/mz9869/tmp_hf_download
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1

PROJECT_ROOT="${HOME}/medusa-qwen"
VENV="${HOME}/medusa-env"
C1=/scratch/li96/mz9869/medusa_outputs/linked_medusa_c1_eagle
B2=/scratch/li96/mz9869/medusa_outputs/linked_medusa_5head_b2
OUT=$C1/ood_mmvet_218
MANIFEST_LLAVA=/g/data/li96/mz9869/data/llava_subset_2k.json
IMAGES_LLAVA=/g/data/li96/mz9869/data/coco_subset
MANIFEST_OOD=/scratch/li96/mz9869/ood_eval/mmvet/manifest_mmvet_218.json
IMAGES_OOD=/scratch/li96/mz9869/ood_eval/mmvet/mm-vet/images

GATE_COMMON="--mode tree --fold-bonus --reorg gather --n-prompts 100 --min-ref-words 80 \
        --max-new-tokens 150 --seed 42 --measure-greedy \
        --manifest $MANIFEST_LLAVA --images-dir $IMAGES_LLAVA"
OOD_COMMON="--mode tree --fold-bonus --reorg gather --n-prompts 218 --min-ref-words 0 \
        --max-new-tokens 150 --seed 42 --measure-greedy --ordered-manifest \
        --check-greedy-bytes \
        --manifest $MANIFEST_OOD --images-dir $IMAGES_OOD"

echo "=== OOD MM-Vet 218 $(hostname) $(date) job=${PBS_JOBID:-N/A} ==="
module load python3/3.11.0 cuda/12.3.2 2>/dev/null || true
source "${VENV}/bin/activate"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader
cd "${PROJECT_ROOT}"
mkdir -p "$OUT" /scratch/li96/mz9869/logs

run () {
    local tag=$1; shift
    echo ""; echo "######## $tag  $* ########"
    python3 -u -m scripts.eval_acceptance_tree "$@" --out "$OUT/$tag.json"
}

# ---- Gate rows (legacy 100) ----
run G1_c1_d3   $GATE_COMMON --ckpt "$C1/ckpt_best.pt" --fanout 1 3 2 1 0 --max-nodes 16
run G2_c1_6432 $GATE_COMMON --ckpt "$C1/ckpt_best.pt" --fanout 1 6 4 3 2 --max-nodes 32
run G3_b2_wide $GATE_COMMON --ckpt "$B2/ckpt_best.pt" --fanout 1 6 4 2 1 --max-nodes 24

# ---- OOD rows (MM-Vet 218; O0 embedded via --check-greedy-bytes) ----
run O1_c1_d3   $OOD_COMMON --ckpt "$C1/ckpt_best.pt" --fanout 1 3 2 1 0 --max-nodes 16
run O2_c1_6432 $OOD_COMMON --ckpt "$C1/ckpt_best.pt" --fanout 1 6 4 3 2 --max-nodes 32
run O3_b2_d3   $OOD_COMMON --ckpt "$B2/ckpt_best.pt" --fanout 1 3 2 1 0 --max-nodes 16
run O4_b2_6432 $OOD_COMMON --ckpt "$B2/ckpt_best.pt" --fanout 1 6 4 3 2 --max-nodes 32

echo ""; echo "=== A BATCH TABLE + GATES + R ==="
python3 - << 'EOF'
import json, math, statistics, sys
from pathlib import Path
out = Path("/scratch/li96/mz9869/medusa_outputs/linked_medusa_c1_eagle/ood_mmvet_218")

def load(tag):
    return json.load(open(out / f"{tag}.json"))

def row(name, tag):
    d = load(tag)
    acc = d["per_position_accept_rate"]
    a = [f"{x:.3f}" for x in (acc[1:]+[0,0,0,0])[:4]]
    print(f"{name:>22} σ={d['sigma_mean']:.3f} N̄={d['mean_tree_width']:.2f} "
          f"tree={d['tree_tok_per_s']:.2f} greedy={d['greedy_tok_per_s']:.2f} "
          f"spd={d['net_speedup_vs_greedy']:.3f} accept[{', '.join(a)}] "
          f"o0_div={d.get('o0_n_diverge')}")

print("--- GATE (LLaVA-Bench 100) ---")
gates = [
    ("G1 C1 [.,3,2,1]x16", "G1_c1_d3", 2.370),
    ("G2 C1 [.,6,4,3,2]x32", "G2_c1_6432", 2.677),
    ("G3 B2 [.,6,4,2,1]x24", "G3_b2_wide", 2.309),
]
ok = True
for name, tag, expect in gates:
    d = load(tag)
    hit = abs(d["sigma_mean"] - expect) < 0.0005
    ok &= hit
    row(name, tag)
    print(f"   GATE σ={expect:.3f} {'OK' if hit else 'FAIL'}")

print("--- OOD (MM-Vet 218) ---")
for name, tag in [
    ("O1 C1 d3", "O1_c1_d3"),
    ("O2 C1 6432", "O2_c1_6432"),
    ("O3 B2 d3", "O3_b2_d3"),
    ("O4 B2 6432", "O4_b2_6432"),
]:
    row(name, tag)

# paired diffs
def paired(tag_a, tag_b):
    a = load(tag_a)["per_prompt_results"]
    b = load(tag_b)["per_prompt_results"]
    # align by order (ordered manifest)
    assert len(a) == len(b) == 218
    diffs = [x["sigma"] - y["sigma"] for x, y in zip(a, b)]
    mean = statistics.mean(diffs)
    std = statistics.stdev(diffs) if len(diffs) > 1 else 0.0
    se = std / math.sqrt(218)
    return mean, std, se, diffs

print("--- paired σ diffs (C1 - B2), SE=std/√218 ---")
m13, s13, e13, _ = paired("O1_c1_d3", "O3_b2_d3")
m24, s24, e24, _ = paired("O2_c1_6432", "O4_b2_6432")
print(f"O1-O3 (narrow): mean={m13:.4f} std={s13:.4f} SE={e13:.4f}")
print(f"O2-O4 (wide):   mean={m24:.4f} std={s24:.4f} SE={e24:.4f}")

sig_o2 = load("O2_c1_6432")["sigma_mean"]
sig_o4 = load("O4_b2_6432")["sigma_mean"]
sig_o1 = load("O1_c1_d3")["sigma_mean"]
sig_o3 = load("O3_b2_d3")["sigma_mean"]
# R uses mean paired diff / 0.310; also report point from aggregates
R_pt = (sig_o2 - sig_o4) / 0.310
R_pair = m24 / 0.310
R_se = e24 / 0.310
R_n_pt = (sig_o1 - sig_o3) / 0.310
R_n_pair = m13 / 0.310
print(f"R_wide point (agg)= {R_pt:.4f}  pair_mean/0.310={R_pair:.4f}  ±1SE=[{R_pair-R_se:.4f}, {R_pair+R_se:.4f}]")
print(f"R_narrow cross-check: agg={R_n_pt:.4f} pair={R_n_pair:.4f}")
a2 = load("O2_c1_6432")["per_position_accept_rate"]
a4 = load("O4_b2_6432")["per_position_accept_rate"]
print(f"head_1 accept O2-O4: {a2[1]:.3f} - {a4[1]:.3f} = {a2[1]-a4[1]:+.3f}")

if not ok:
    print("GATE FAIL — stop"); sys.exit(1)
print("GATE PASS")
EOF
echo "=== DONE $(date) ==="
