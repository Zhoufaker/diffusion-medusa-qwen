#!/bin/bash
#PBS -N phaseA_train
#PBS -P li96
#PBS -q gpuvolta
#PBS -l storage=gdata/li96+scratch/li96
#PBS -l ncpus=12
#PBS -l mem=96GB
#PBS -l ngpus=1
#PBS -l walltime=04:00:00
#PBS -l wd
#PBS -j oe
#PBS -o /scratch/li96/mz9869/logs/

# Phase A FULL training — general-domain heads, v1 init/config apples-to-apples
# (only cache domain differs; NO warm-start of v1 chart heads).
#   - fresh heads -> init_lm_heads_from_base (copy base lm_head) -> identity body
#   - cache_dir = llava_general_35k  (greedy-rollout self-distill, eval domain)
#   - eval_split=last_1000 (in-training loss monitor; real σ is LIVE @ Step 4)
#   - total_steps = ceil((34999-1000)/4) ~= 8500  (1 epoch)
#   - ckpt -> linked_medusa_phaseA_general  (does NOT touch linked_medusa_v1_full)

set -euo pipefail

echo "=== JOB METADATA ==="
echo "PBS_JOBID = ${PBS_JOBID:-unset}"
echo "hostname  = $(hostname)"
echo "date      = $(date)"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader | head -1
echo

module load python3/3.11.0 cuda/12.3.2
source ~/medusa-env/bin/activate
cd ~/medusa-qwen

python -c "import torch; print('torch', torch.__version__, torch.cuda.is_available())"
python -c "import bitsandbytes; print('bitsandbytes', bitsandbytes.__version__)"
echo

# Write/refresh manifest over all shards (record-keeping; CachedVLMDataset
# does not require it, but keep parity with v1 cache layout).
python -u -m scripts.gen_cache_rollout \
    --out-dir /scratch/li96/mz9869/cached_data/llava_general_35k --manifest-only || true
echo

PROD_OVERRIDES=(
    dataset.kind=cached
    dataset.cache_dir=/scratch/li96/mz9869/cached_data/llava_general_35k
    dataset.eval_split=last_1000
    training.total_steps=8500
    logging.log_every=50
    logging.eval_every=500
    logging.save_every=1000
    logging.output_dir=/scratch/li96/mz9869/medusa_outputs/linked_medusa_phaseA_general
)

echo "=== launch: ${PROD_OVERRIDES[*]} ==="
python -u -m scripts.train --config config/linked_medusa_default.yaml --override "${PROD_OVERRIDES[@]}"

echo "=== DONE $(date) ==="
