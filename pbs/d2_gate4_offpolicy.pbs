#!/bin/bash
# 门4 保真度(独立执行,预授权条件 b')+ off-policy 附属实验合并单
# (2026-08-18 用户授权)。免审档:已过审组件重组(--eval-only 与
# d2_offpolicy_aux 均既有入口),无新逻辑。
# 门4 判据:pinned 终档 --eval-only 的 val CE 与 epoch_3_stats.json
# 记录值(3.2943458766937255)复现差 <1e-3。
#PBS -P li96
#PBS -q dgxa100
#PBS -l ncpus=16
#PBS -l ngpus=1
#PBS -l mem=150GB
#PBS -l jobfs=10GB
#PBS -l walltime=00:45:00
#PBS -l storage=gdata/li96+scratch/li96
#PBS -l wd
#PBS -N d2_gate4_offp
#PBS -o /scratch/li96/mz9869/logs/
#PBS -j oe
#PBS -m ae
#PBS -M 920928763@qq.com

set -u
module load python3/3.11.0 cuda/12.3.2
source ~/medusa-env/bin/activate
export HF_HOME=/scratch/li96/mz9869/tmp_hf_download/
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export PIP_CACHE_DIR=/scratch/li96/mz9869/tmp_pip_cache/

PIN=/scratch/li96/mz9869/dflash_data/drafter_ckpt_full/drafter_best_final_pinned.pt
G4OUT=/scratch/li96/mz9869/dflash_data/d2/gate4
OPOUT=/scratch/li96/mz9869/dflash_data/d2/offpolicy
mkdir -p ${G4OUT} ${OPOUT}
cd /home/562/mz9869/medusa-qwen
echo "=== gate4 + offpolicy $(date) commit $(git rev-parse --short HEAD) ==="

python train/train_drafter.py \
    --eval-only --init-from ${PIN} \
    --cache-dir /scratch/li96/mz9869/dflash_data/ctx_cache_35k \
    --out-dir ${G4OUT}
RC1=$?

python scripts/d2_offpolicy_aux.py \
    --drafter-ckpt ${PIN} \
    --out ${OPOUT}/offpolicy_result.json
RC2=$?

python - <<PYEOF
import json
REF = 3.2943458766937255      # epoch_3_stats.json val mean_loss(best 档来源)
s = {"job": "${PBS_JOBID}", "kind": "d2_gate4_offpolicy",
     "exit_gate4": ${RC1}, "exit_offpolicy": ${RC2}}
try:
    ce = json.load(open("${G4OUT}/eval_only.json"))["mean_loss"]
    s.update(gate4_val_ce=ce, gate4_ref=REF,
             gate4_abs_diff=abs(ce - REF),
             gate4_pass=(${RC1} == 0 and abs(ce - REF) < 1e-3))
except Exception as e:
    s["gate4_error"] = str(e)[:200]; s["gate4_pass"] = False
try:
    s["offpolicy"] = json.load(open("${OPOUT}/offpolicy_result.json"))
except Exception as e:
    s["offpolicy_error"] = str(e)[:200]
json.dump(s, open("${G4OUT}/JOB_DONE_${PBS_JOBID%%.*}.json", "w"), indent=1)
print("sentinel:", json.dumps(s)[:600])
PYEOF
echo "=== DONE $(date) rc=${RC1}/${RC2} ==="
exit $(( RC1 > RC2 ? RC1 : RC2 ))
