#!/bin/bash
# 2x2 drift attribution — Arm1: V100 + incremental rollout.
# gen_cache_rollout.py runs UNMODIFIED (June-parity). Index subset achieved via
# pre-seeded dummy .pt files (script's documented skip-if-exists resume path);
# only the 50 panel indices are computed. --limit 500 bounds the scan.
#PBS -P li96
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=96GB
#PBS -l jobfs=10GB
#PBS -l walltime=00:40:00
#PBS -l storage=gdata/li96+scratch/li96
#PBS -l wd
#PBS -N drift_arm1
#PBS -o /scratch/li96/mz9869/logs/
#PBS -j oe
#PBS -m ae
#PBS -M 920928763@qq.com

set -u
module load python3/3.11.0 cuda/12.3.2
source ~/medusa-env/bin/activate
export HF_HOME=/scratch/li96/mz9869/tmp_hf_download/
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export PIP_CACHE_DIR=/scratch/li96/mz9869/tmp_pip_cache/

cd /home/562/mz9869/medusa-qwen
echo "=== drift Arm1 V100+inc $(date) commit $(git rev-parse --short HEAD) ==="
python scripts/gen_cache_rollout.py \
    --out-dir /scratch/li96/mz9869/dflash_data/drift_exp/arm1_v100_inc \
    --limit 500
RC=$?
echo "{\"job\":\"${PBS_JOBID}\",\"arm\":\"arm1_v100_inc\",\"exit\":${RC},\"out\":\"drift_exp/arm1_v100_inc\"}" \
  > /scratch/li96/mz9869/dflash_data/drift_exp/JOB_DONE_${PBS_JOBID%%.*}.json
echo "=== DONE $(date) rc=${RC} ==="
exit ${RC}
