#!/bin/bash
#PBS -P li96
#PBS -q gpuvolta
#PBS -l ngpus=1,ncpus=12,mem=96GB
#PBS -l walltime=03:00:00
#PBS -l storage=gdata/li96+scratch/li96
#PBS -l wd
#PBS -N diag_3a_hook
#PBS -j oe
#PBS -o /scratch/li96/mz9869/logs/

# 3a: greedy+hook h-dump for remaining deep positions (process-isolated), then CPU top-3.

set -euo pipefail
export HF_HOME=/scratch/li96/mz9869/tmp_hf_download
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1

PROJECT_ROOT="${HOME}/medusa-qwen"
VENV="${HOME}/medusa-env"
OUT=/scratch/li96/mz9869/medusa_outputs/linked_medusa_c1_eagle/diag_triad

echo "=== 3a GREEDY-HOOK $(hostname) $(date) job=${PBS_JOBID:-N/A} ==="
module load python3/3.11.0 cuda/12.3.2 2>/dev/null || true
source "${VENV}/bin/activate"
cd "${PROJECT_ROOT}"
mkdir -p "$OUT/item3_h_fp16"

# 5 remaining 16=32=Y deep rows (+ any other missing from the 9)
python3 - <<'PY' > /tmp/item3_hook_todo.txt
import json
from pathlib import Path
td=Path("/scratch/li96/mz9869/medusa_outputs/linked_medusa_c1_eagle/diag_triad")
audit=json.load(open(td/"item3_fp32_audit.json"))
hdir=td/"item3_h_fp16"
for r in audit:
    pid,pos=r["prompt_id"],r["pos"]
    if (hdir/f"{pid}_pos{pos}.pt").exists():
        continue
    print(f"{pid} {pos}")
PY

while read -r PID POS; do
  [[ -z "${PID:-}" ]] && continue
  echo ""; echo "######## HOOK $PID pos=$POS ########"
  python3 -u -m scripts.diag_item3_h_hook \
    --prompt-id "$PID" --pos "$POS" --out-dir "$OUT" \
    || echo "FAIL $PID pos=$POS exit=$?"
done < /tmp/item3_hook_todo.txt

echo ""; echo "=== CPU top-3 ==="
python3 -u -m scripts.diag_item3_top3_cpu --out-dir "$OUT"
echo "=== DONE $(date) ==="
