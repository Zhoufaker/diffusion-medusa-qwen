#!/bin/bash
#PBS -P li96
#PBS -q gpuvolta
#PBS -l ngpus=1,ncpus=12,mem=96GB
#PBS -l walltime=10:00:00
#PBS -l storage=gdata/li96+scratch/li96
#PBS -l wd
#PBS -N a_full_501760
#PBS -j oe
#PBS -o /scratch/li96/mz9869/logs/

# A-batch FULL (smoke 174156697 reclassified PASS under peak≤30.0 GiB gate).
# 218 @ max_pixels=501760; G1-G3 + O1-O4; O0: archive hard / MM-Vet fingerprint.

set -euo pipefail
export HF_HOME=/scratch/li96/mz9869/tmp_hf_download
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1

PROJECT_ROOT="${HOME}/medusa-qwen"
VENV="${HOME}/medusa-env"
C1=/scratch/li96/mz9869/medusa_outputs/linked_medusa_c1_eagle
B2=/scratch/li96/mz9869/medusa_outputs/linked_medusa_5head_b2
OUT=$C1/ood_mmvet_218
MANIFEST_LLAVA=/g/data/li96/mz9869/data/llava_subset_2k.json
IMAGES_LLAVA=/g/data/li96/mz9869/data/coco_subset
MANIFEST_OOD=/scratch/li96/mz9869/ood_eval/mmvet/manifest_mmvet_218.json
IMAGES_OOD=/scratch/li96/mz9869/ood_eval/mmvet/mm-vet/images
MAX_PX=501760

ARCH_G1=$C1/final_eval/c1_d3.json
ARCH_G2=$C1/fanout_sweep/c10_6432_32.json
ARCH_G3=$C1/final_eval/b2_wide.json

echo "=== A FULL 501760 $(hostname) $(date) job=${PBS_JOBID:-N/A} ==="
echo "smoke prior: peak=29.252 GiB (PASS under ≤30.0 gate)"
module load python3/3.11.0 cuda/12.3.2 2>/dev/null || true
source "${VENV}/bin/activate"
cd "${PROJECT_ROOT}"
mkdir -p "$OUT" /scratch/li96/mz9869/logs

GATE_COMMON="--mode tree --fold-bonus --reorg gather --n-prompts 100 --min-ref-words 80 \
        --max-new-tokens 150 --seed 42 --measure-greedy --check-greedy-bytes \
        --manifest $MANIFEST_LLAVA --images-dir $IMAGES_LLAVA"
OOD_COMMON="--mode tree --fold-bonus --reorg gather --n-prompts 218 --min-ref-words 0 \
        --max-new-tokens 150 --seed 42 --measure-greedy --ordered-manifest \
        --check-greedy-bytes --max-pixels $MAX_PX \
        --manifest $MANIFEST_OOD --images-dir $IMAGES_OOD"

run () {
    local tag=$1; shift
    echo ""; echo "######## $tag ########"
    python3 -u -m scripts.eval_acceptance_tree "$@" --out "$OUT/$tag.json"
}

run G1_c1_d3   $GATE_COMMON --ckpt "$C1/ckpt_best.pt" --fanout 1 3 2 1 0 --max-nodes 16 \
    --o0-archive "$ARCH_G1"
run G2_c1_6432 $GATE_COMMON --ckpt "$C1/ckpt_best.pt" --fanout 1 6 4 3 2 --max-nodes 32 \
    --o0-archive "$ARCH_G2"
run G3_b2_wide $GATE_COMMON --ckpt "$B2/ckpt_best.pt" --fanout 1 6 4 2 1 --max-nodes 24 \
    --o0-archive "$ARCH_G3"

run O1_c1_d3   $OOD_COMMON --ckpt "$C1/ckpt_best.pt" --fanout 1 3 2 1 0 --max-nodes 16 \
    --o0-write-archive "$OUT/O1_c1_d3.o0_archive.json"
run O2_c1_6432 $OOD_COMMON --ckpt "$C1/ckpt_best.pt" --fanout 1 6 4 3 2 --max-nodes 32 \
    --o0-write-archive "$OUT/O2_c1_6432.o0_archive.json"
run O3_b2_d3   $OOD_COMMON --ckpt "$B2/ckpt_best.pt" --fanout 1 3 2 1 0 --max-nodes 16 \
    --o0-write-archive "$OUT/O3_b2_d3.o0_archive.json"
run O4_b2_6432 $OOD_COMMON --ckpt "$B2/ckpt_best.pt" --fanout 1 6 4 3 2 --max-nodes 32 \
    --o0-write-archive "$OUT/O4_b2_6432.o0_archive.json"

python3 - << 'EOF'
import json, math, statistics, sys
from pathlib import Path
out = Path("/scratch/li96/mz9869/medusa_outputs/linked_medusa_c1_eagle/ood_mmvet_218")

def load(tag):
    return json.load(open(out / f"{tag}.json"))

ok = True
print("--- GATE ---")
for name, tag, expect in [
    ("G1 C1 d3", "G1_c1_d3", 2.370),
    ("G2 C1 6432", "G2_c1_6432", 2.677),
    ("G3 B2 wide", "G3_b2_wide", 2.309),
]:
    d = load(tag)
    hit = abs(d["sigma_mean"] - expect) < 0.0005
    o0bad = bool(d.get("o0_n_archive_hard_fail") or d.get("o0_n_fingerprint_fail"))
    ok &= hit and not o0bad
    print(f"{name}: σ={d['sigma_mean']:.3f} GATE={expect} {'OK' if hit else 'FAIL'} "
          f"o0_hard={d.get('o0_n_archive_hard_fail')} o0_fp={d.get('o0_n_fingerprint_fail')} "
          f"peak={d.get('peak_alloc_gib')}")

print("--- OOD ---")
for name, tag in [("O1","O1_c1_d3"),("O2","O2_c1_6432"),("O3","O3_b2_d3"),("O4","O4_b2_6432")]:
    d = load(tag)
    if d.get("o0_n_fingerprint_fail"):
        ok = False
    print(f"{name}: σ={d['sigma_mean']:.3f} N̄={d['mean_tree_width']:.2f} "
          f"peak={d.get('peak_alloc_gib')} o0_fp={d.get('o0_n_fingerprint_fail')} "
          f"o0_info={d.get('o0_n_info_vs_greedy')}")

A=load("O2_c1_6432")["per_prompt_results"]
B=load("O4_b2_6432")["per_prompt_results"]
diffs=[x["sigma"]-y["sigma"] for x,y in zip(A,B)]
m=statistics.mean(diffs); se=statistics.stdev(diffs)/math.sqrt(218)
print(f"R_wide pair/0.310={m/0.310:.4f} ±SE={se/0.310:.4f}")
sys.exit(0 if ok else 1)
EOF
echo "=== DONE $(date) ==="
