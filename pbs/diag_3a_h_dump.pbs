#!/bin/bash
#PBS -P li96
#PBS -q gpuvolta
#PBS -l ngpus=1,ncpus=12,mem=96GB
#PBS -l walltime=04:00:00
#PBS -l storage=gdata/li96+scratch/li96
#PBS -l wd
#PBS -N diag_3a_hdump
#PBS -j oe
#PBS -o /scratch/li96/mz9869/logs/

# 3a: dump h@audit positions → CPU fp32 top-3; item5 mem probes (A still frozen).

set -euo pipefail
export HF_HOME=/scratch/li96/mz9869/tmp_hf_download
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1

PROJECT_ROOT="${HOME}/medusa-qwen"
VENV="${HOME}/medusa-env"
OUT=/scratch/li96/mz9869/medusa_outputs/linked_medusa_c1_eagle/diag_triad

echo "=== 3a H-DUMP $(hostname) $(date) job=${PBS_JOBID:-N/A} ==="
module load python3/3.11.0 cuda/12.3.2 2>/dev/null || true
source "${VENV}/bin/activate"
cd "${PROJECT_ROOT}"
mkdir -p "$OUT" /scratch/li96/mz9869/logs

python3 -u -m scripts.diag_item3_h_dump --out-dir "$OUT"
echo "=== DONE $(date) ==="
