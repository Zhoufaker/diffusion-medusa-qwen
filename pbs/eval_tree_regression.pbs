#!/bin/bash
#PBS -P li96
#PBS -q gpuvolta
#PBS -l ngpus=1,ncpus=12,mem=64GB
#PBS -l walltime=00:30:00
#PBS -l storage=gdata/li96+scratch/li96
#PBS -l wd
#PBS -N eval_tree_regression
#PBS -j oe
#PBS -o /scratch/li96/mz9869/medusa_outputs/eval_tree_regression.log

set -euo pipefail

PROJECT_ROOT="${HOME}/medusa-qwen"
VENV="${HOME}/medusa-env"

echo "================================================================"
echo "TREE REGRESSION GATE: fanout=[1,1,1] tree == chain (byte-identical)"
echo "host: $(hostname)   date: $(date)   job: ${PBS_JOBID:-N/A}"
echo "================================================================"

module load python3/3.11.0 cuda/12.3.2 2>/dev/null || true
source "${VENV}/bin/activate"
echo "[env] torch: $(python3 -c 'import torch; print(torch.__version__, torch.cuda.is_available())')"
echo "[env] transformers: $(python3 -c 'import transformers; print(transformers.__version__)')"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader

cd "${PROJECT_ROOT}"
python3 -u -m scripts.eval_acceptance_tree \
  --mode regression \
  --n-prompts 5 \
  --max-new-tokens 80
echo "EXIT_CODE=$?"
echo "DONE $(date)"
