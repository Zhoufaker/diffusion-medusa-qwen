#!/bin/bash
#PBS -P li96
#PBS -q gpuvolta
#PBS -l ngpus=1,ncpus=12,mem=96GB
#PBS -l walltime=24:00:00
#PBS -l storage=gdata/li96+scratch/li96
#PBS -l wd
#PBS -N e2e_t3
#PBS -j oe
#PBS -o /scratch/li96/mz9869/logs/

# Priority: (2b) e2e-wall speed_300 7 rows → (4a) static materialize equiv →
#           (4b) dynamic O0 on 300 + MM-Vet 218.
# Dynamic remains experimental until 2c band read + 4b O0 green.

set -euo pipefail
export HF_HOME=/scratch/li96/mz9869/tmp_hf_download
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1

PROJECT_ROOT="${HOME}/medusa-qwen"
VENV="${HOME}/medusa-env"
C1=/scratch/li96/mz9869/medusa_outputs/linked_medusa_c1_eagle
B2=/scratch/li96/mz9869/medusa_outputs/linked_medusa_5head_b2
OUT=$C1/e2e_speed_300
OUT_T3=$C1/tier3_attrib_o0
MANIFEST300=/scratch/li96/mz9869/eval_manifests/manifest_300.json
MANIFEST100=/g/data/li96/mz9869/data/llava_subset_2k.json
MANIFEST_OOD=/scratch/li96/mz9869/ood_eval/mmvet/manifest_mmvet_218.json
IMAGES=/g/data/li96/mz9869/data/coco_subset
IMAGES_OOD=/scratch/li96/mz9869/ood_eval/mmvet/mm-vet/images

echo "=== E2E SPEED + TIER3 $(hostname) $(date) job=${PBS_JOBID:-N/A} ==="
module load python3/3.11.0 cuda/12.3.2 2>/dev/null || true
source "${VENV}/bin/activate"
cd "${PROJECT_ROOT}"
mkdir -p "$OUT" "$OUT_T3" /scratch/li96/mz9869/logs

COMMON300="--mode tree --fold-bonus --reorg gather --n-prompts 300 --min-ref-words 80 \
        --max-new-tokens 150 --seed 42 --ordered-manifest --e2e-wall \
        --manifest $MANIFEST300 --images-dir $IMAGES"
COMMON100="--mode tree --fold-bonus --reorg gather --n-prompts 100 --min-ref-words 80 \
        --max-new-tokens 150 --seed 42 --e2e-wall \
        --manifest $MANIFEST100 --images-dir $IMAGES"

run () {
  local tag=$1; shift
  echo ""; echo "######## $tag  $* ########"
  python3 -u -m scripts.eval_acceptance_tree "$@" --out "$OUT/$tag.json"
}

# ---------- 2b: seven rows (greedy once + 6 tree) ----------
echo ""; echo "===== PHASE 2b: E2E WALL SPEED_300 ====="
run greedy_e2e --mode greedy_e2e --n-prompts 300 --min-ref-words 80 \
  --max-new-tokens 150 --seed 42 --ordered-manifest \
  --ckpt $C1/ckpt_best.pt --fanout 1 3 2 1 0 \
  --manifest $MANIFEST300 --images-dir $IMAGES

run static_c1_d3   --tree-builder static --ckpt $C1/ckpt_best.pt \
  $COMMON300 --fanout 1 3 2 1 0 --max-nodes 16
run static_c1_6432 --tree-builder static --ckpt $C1/ckpt_best.pt \
  $COMMON300 --fanout 1 6 4 3 2 --max-nodes 32
run static_b2_d3   --tree-builder static --ckpt $B2/ckpt_best.pt \
  $COMMON300 --fanout 1 3 2 1 0 --max-nodes 16
run static_b2_6432 --tree-builder static --ckpt $B2/ckpt_best.pt \
  $COMMON300 --fanout 1 6 4 3 2 --max-nodes 32
run dyn_k8_n24     --tree-builder dynamic --ckpt $C1/ckpt_best.pt \
  $COMMON300 --fanout 1 8 8 8 8 --max-nodes 24
run dyn_k8_n32     --tree-builder dynamic --ckpt $C1/ckpt_best.pt \
  $COMMON300 --fanout 1 8 8 8 8 --max-nodes 32

echo ""; echo "===== PHASE 2b: PAIR + BAND READ ====="
python3 - <<'EOF'
import json, math, statistics, sys
from pathlib import Path

out = Path("/scratch/li96/mz9869/medusa_outputs/linked_medusa_c1_eagle/e2e_speed_300")
g = json.load(open(out / "greedy_e2e.json"))
gw = {str(r["id"]): r["e2e_wall_s"] for r in g["per_prompt_results"]}

def pair(tag):
    d = json.load(open(out / f"{tag}.json"))
    ratios = []
    for r in d["per_prompt_results"]:
        pid = str(r["id"])
        sw = r["e2e_wall_s"]
        ratios.append(gw[pid] / sw)
        r["greedy_e2e_wall_s"] = gw[pid]
        r["paired_speedup"] = gw[pid] / sw
    m = statistics.mean(ratios)
    se = statistics.stdev(ratios) / math.sqrt(len(ratios))
    d["timing_protocol"] = "e2e_wall"
    d["paired_speedup_mean"] = m
    d["paired_speedup_se"] = se
    d["paired_speedup_n"] = len(ratios)
    d["greedy_e2e_source"] = str(out / "greedy_e2e.json")
    with open(out / f"{tag}.json", "w") as f:
        json.dump(d, f, indent=2)
    return m, se, d["sigma_mean"], d["mean_tree_width"]

rows = {}
print(f"{'tag':22s} {'spd±SE':22s} {'σ':8s} {'N̄':8s}")
for tag in ["static_c1_d3","static_c1_6432","static_b2_d3","static_b2_6432",
            "dyn_k8_n24","dyn_k8_n32"]:
    m, se, sig, nb = pair(tag)
    rows[tag] = {"paired_speedup_mean": m, "paired_speedup_se": se,
                 "sigma_mean": sig, "mean_tree_width": nb}
    print(f"{tag:22s} {m:.4f} ± {se:.4f}     {sig:.3f}   {nb:.2f}")

# 2c pre-registered: dyn_k8_n24 vs static_c1_d3 paired diff of per-prompt speedups
a = json.load(open(out / "dyn_k8_n24.json"))
b = json.load(open(out / "static_c1_d3.json"))
diffs = []
mb = {str(r["id"]): r["paired_speedup"] for r in b["per_prompt_results"]}
for r in a["per_prompt_results"]:
    diffs.append(r["paired_speedup"] - mb[str(r["id"])])
dm = statistics.mean(diffs)
dse = statistics.stdev(diffs) / math.sqrt(len(diffs))
# 1% band of static c1_d3 mean speedup
anchor = rows["static_c1_d3"]["paired_speedup_mean"]
band = 0.01 * anchor
out_of_band = abs(dm) > band + dse   # conservative: mean beyond band by >1SE? 
# Spec: "配对差 ±SE — 带外则 speed champion 维持动态; 带内(1%)则并列"
# Interpret: if |dm|±SE interval overlaps [-band, +band] → in-band (并列);
# else out-of-band.
lo, hi = dm - dse, dm + dse
in_band = not (hi < -band or lo > band)
verdict = "速度冠军并列/未分" if in_band else (
    "speed champion = dyn_k8_n24" if dm > 0 else "speed champion = static_c1_d3"
)
summary = {
    "job": __import__("os").environ.get("PBS_JOBID"),
    "protocol": "e2e_wall paired greedy_wall/spec_wall",
    "rows": rows,
    "dyn_n24_vs_static_d3": {
        "delta_mean": dm, "delta_se": dse, "n": len(diffs),
        "anchor_spd": anchor, "band_1pct": band,
        "interval": [lo, hi], "in_band": in_band, "verdict": verdict,
    },
    "sigma_champion_unchanged": "dyn_k8_n32 σ=2.841 (not re-judged here)",
}
json.dump(summary, open(out / "e2e_speed_summary.json", "w"), indent=2, ensure_ascii=False)
print(f"\n2c: Δ(dyn_n24 − static_d3) = {dm:+.4f} ± {dse:.4f}  "
      f"1% band=±{band:.4f}  in_band={in_band}")
print(f"VERDICT: {verdict}")
EOF

# ---------- 4a: static materialize [1,8,8,8,8]×32 vs dyn on old100 ----------
echo ""; echo "===== PHASE 4a: STATIC MATERIALIZE EQUIV ====="
python3 -u -m scripts.eval_acceptance_tree \
  --mode tree --fold-bonus --reorg gather --n-prompts 100 --min-ref-words 80 \
  --max-new-tokens 150 --seed 42 --tree-builder static \
  --ckpt $C1/ckpt_best.pt --fanout 1 8 8 8 8 --max-nodes 32 \
  --manifest $MANIFEST100 --images-dir $IMAGES \
  --out $OUT_T3/static_mat_k8_n32_old100.json

python3 -u -m scripts.eval_acceptance_tree \
  --mode tree --fold-bonus --reorg gather --n-prompts 100 --min-ref-words 80 \
  --max-new-tokens 150 --seed 42 --tree-builder dynamic \
  --ckpt $C1/ckpt_best.pt --fanout 1 8 8 8 8 --max-nodes 32 \
  --manifest $MANIFEST100 --images-dir $IMAGES \
  --out $OUT_T3/dyn_k8_n32_old100.json

python3 - <<'EOF'
import json, sys
from pathlib import Path
out = Path("/scratch/li96/mz9869/medusa_outputs/linked_medusa_c1_eagle/tier3_attrib_o0")
a = json.load(open(out / "static_mat_k8_n32_old100.json"))
b = json.load(open(out / "dyn_k8_n32_old100.json"))
pa, pb = a["per_prompt_results"], b["per_prompt_results"]
assert len(pa) == len(pb)
n_ok = 0
fail = None
for i, (x, y) in enumerate(zip(pa, pb)):
    if (x["sigma"] != y["sigma"] or x["mean_width"] != y["mean_width"]
            or x["emitted_tokens"] != y["emitted_tokens"]):
        fail = (i, x["id"], x["sigma"], y["sigma"], x["mean_width"], y["mean_width"])
        break
    n_ok += 1
rep = {"n_ok": n_ok, "n": len(pa), "pass": fail is None, "fail": fail,
       "sigma_static": a["sigma_mean"], "sigma_dyn": b["sigma_mean"],
       "Nbar_static": a["mean_tree_width"], "Nbar_dyn": b["mean_tree_width"]}
json.dump(rep, open(out / "attrib_equiv_summary.json", "w"), indent=2)
print("4a static-materialize ≡ dyn:", "PASS" if fail is None else f"FAIL {fail}")
if fail is not None:
    sys.exit(1)
EOF

# ---------- 4b: O0 dyn_k8_n24/n32 on 300 + MM-Vet 218 ----------
echo ""; echo "===== PHASE 4b: DYNAMIC O0 ====="
O0_COMMON_300="--mode tree --fold-bonus --reorg gather --n-prompts 300 --min-ref-words 80 \
  --max-new-tokens 150 --seed 42 --ordered-manifest --check-greedy-bytes \
  --ckpt $C1/ckpt_best.pt --manifest $MANIFEST300 --images-dir $IMAGES"
O0_COMMON_OOD="--mode tree --fold-bonus --reorg gather --n-prompts 218 --min-ref-words 0 \
  --max-new-tokens 150 --seed 42 --ordered-manifest --check-greedy-bytes \
  --max-pixels 501760 --ckpt $C1/ckpt_best.pt \
  --manifest $MANIFEST_OOD --images-dir $IMAGES_OOD"

python3 -u -m scripts.eval_acceptance_tree $O0_COMMON_300 \
  --tree-builder dynamic --fanout 1 8 8 8 8 --max-nodes 24 \
  --out $OUT_T3/o0_dyn_k8_n24_300.json \
  --o0-write-archive $OUT_T3/o0_dyn_k8_n24_300.o0_archive.json

python3 -u -m scripts.eval_acceptance_tree $O0_COMMON_300 \
  --tree-builder dynamic --fanout 1 8 8 8 8 --max-nodes 32 \
  --out $OUT_T3/o0_dyn_k8_n32_300.json \
  --o0-write-archive $OUT_T3/o0_dyn_k8_n32_300.o0_archive.json

python3 -u -m scripts.eval_acceptance_tree $O0_COMMON_OOD \
  --tree-builder dynamic --fanout 1 8 8 8 8 --max-nodes 24 \
  --out $OUT_T3/o0_dyn_k8_n24_mmvet.json \
  --o0-write-archive $OUT_T3/o0_dyn_k8_n24_mmvet.o0_archive.json

python3 -u -m scripts.eval_acceptance_tree $O0_COMMON_OOD \
  --tree-builder dynamic --fanout 1 8 8 8 8 --max-nodes 32 \
  --out $OUT_T3/o0_dyn_k8_n32_mmvet.json \
  --o0-write-archive $OUT_T3/o0_dyn_k8_n32_mmvet.o0_archive.json

python3 - <<'EOF'
import json
from pathlib import Path
out = Path("/scratch/li96/mz9869/medusa_outputs/linked_medusa_c1_eagle/tier3_attrib_o0")
rows = {}
ok_all = True
for tag in ["o0_dyn_k8_n24_300","o0_dyn_k8_n32_300","o0_dyn_k8_n24_mmvet","o0_dyn_k8_n32_mmvet"]:
    d = json.load(open(out / f"{tag}.json"))
    hard = d.get("o0_n_archive_hard_fail") or 0
    fp = d.get("o0_n_fingerprint_fail") or 0
    passed = (hard == 0 and fp == 0)
    ok_all = ok_all and passed
    rows[tag] = {
        "pass": passed, "hard_fail": hard, "fp_fail": fp,
        "sigma": d["sigma_mean"], "Nbar": d["mean_tree_width"],
        "n": d["n_prompts"],
    }
    print(f"{tag}: {'PASS' if passed else 'FAIL'} hard={hard} fp={fp} "
          f"σ={d['sigma_mean']:.3f} N̄={d['mean_tree_width']:.2f}")
json.dump({"rows": rows, "all_pass": ok_all}, open(out / "o0_summary.json", "w"), indent=2)
raise SystemExit(0 if ok_all else 1)
EOF

echo "=== DONE $(date) ==="
