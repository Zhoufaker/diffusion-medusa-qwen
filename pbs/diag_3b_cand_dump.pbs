#!/bin/bash
#PBS -P li96
#PBS -q gpuvolta
#PBS -l ngpus=1,ncpus=12,mem=96GB
#PBS -l walltime=03:00:00
#PBS -l storage=gdata/li96+scratch/li96
#PBS -l wd
#PBS -N diag_3b_dump
#PBS -j oe
#PBS -o /scratch/li96/mz9869/logs/

# 3b(a): static gate#2 on old100; dump per-round top-6. Then CPU offline diff
# on σ-drift prompts [10,58,78,85] first-diverge rounds → stop-and-wait.

set -euo pipefail
export HF_HOME=/scratch/li96/mz9869/tmp_hf_download
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1

PROJECT_ROOT="${HOME}/medusa-qwen"
VENV="${HOME}/medusa-env"
C1=/scratch/li96/mz9869/medusa_outputs/linked_medusa_c1_eagle
OUT=$C1/diag_triad/item6_offline
CKPT=$C1/ckpt_best.pt
MANIFEST=/scratch/li96/mz9869/eval_manifests/manifest_old100_gate.json
# fallback if materialized old100 missing
if [[ ! -f "$MANIFEST" ]]; then
  MANIFEST=/g/data/li96/mz9869/data/llava_subset_2k.json
fi

echo "=== 3b CAND DUMP + OFFLINE DIFF $(hostname) $(date) job=${PBS_JOBID:-N/A} ==="
module load python3/3.11.0 cuda/12.3.2 2>/dev/null || true
source "${VENV}/bin/activate"
cd "${PROJECT_ROOT}"
mkdir -p "$OUT" /scratch/li96/mz9869/logs

DUMP=$OUT/gate2_old100_top6.jsonl

# Full old100 dump (gate#2). Normal V100 mem — static path only.
python3 -u -m scripts.diag_item6_cand_dump \
  --ckpt "$CKPT" \
  --manifest "$MANIFEST" \
  --fanout 1 6 4 2 1 \
  --max-nodes 24 \
  --n-prompts 100 \
  --dump-jsonl "$DUMP" \
  --summary-out "$OUT/gate2_old100_top6.summary.json"

# Resolve drift prompt ids from indices
python3 -u - <<PY
import json, sys
from pathlib import Path
sys.path.insert(0, str(Path.home() / "medusa-qwen"))
from decode.common import filter_prompts
manifest = "$MANIFEST"
prompts = filter_prompts(manifest, 80, 42, ordered=False)[:100]
drift_idx = [10, 58, 78, 85]
ids = [str(prompts[i]["id"]) for i in drift_idx]
print("drift ids:", list(zip(drift_idx, ids)))
open("$OUT/drift_prompt_ids.json", "w").write(json.dumps(
    {"indices": drift_idx, "prompt_ids": ids}, indent=2))
PY

DRIFT_IDS=$(python3 -c "import json; print(' '.join(json.load(open('$OUT/drift_prompt_ids.json'))['prompt_ids']))")

python3 -u -m scripts.diag_item6_offline_diff \
  --dump-jsonl "$DUMP" \
  --prompt-ids $DRIFT_IDS \
  --stop-after-first-diffs 4 \
  --out "$OUT/drift_first_diffs.json"

echo "=== DONE $(date) ==="
echo "Paste-ready: $OUT/drift_first_diffs.json"
