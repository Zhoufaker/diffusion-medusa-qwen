#!/bin/bash
#PBS -P li96
#PBS -q gpuvolta
#PBS -l ngpus=1,ncpus=12,mem=96GB
#PBS -l walltime=01:00:00
#PBS -l storage=gdata/li96+scratch/li96
#PBS -l wd
#PBS -N diag_top3_mem
#PBS -j oe
#PBS -o /scratch/li96/mz9869/logs/

set -euo pipefail
export HF_HOME=/scratch/li96/mz9869/tmp_hf_download
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
PROJECT_ROOT="${HOME}/medusa-qwen"
VENV="${HOME}/medusa-env"
OUT=/scratch/li96/mz9869/medusa_outputs/linked_medusa_c1_eagle/diag_triad

echo "=== diag top3+mem $(hostname) $(date) job=${PBS_JOBID:-N/A} ==="
module load python3/3.11.0 cuda/12.3.2 2>/dev/null || true
source "${VENV}/bin/activate"
cd "${PROJECT_ROOT}"
mkdir -p "$OUT"

python3 -u scripts/diag_item3_top3.py
python3 -u scripts/diag_item5_mem.py --max-pixels 501760 \
  --out "$OUT/item5_mem_v1_82_501760.json"
python3 -u scripts/diag_item5_mem.py --max-pixels 1003520 \
  --image /scratch/li96/mz9869/ood_eval/mmvet/mm-vet/images/v1_0.jpg \
  --out "$OUT/item5_mem_v1_0_1003520.json" || true

echo "=== DONE $(date) ==="
